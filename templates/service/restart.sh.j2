#!/bin/bash
# Poste.io Service Restart Script

set -e

POSTEIO_DIR="{{ posteio_dir }}"

cd "$POSTEIO_DIR"

if [ ! -f "docker-compose.yml" ]; then
    echo "Error: docker-compose.yml not found in $POSTEIO_DIR" >&2
    exit 1
fi

echo "Restarting Poste.io containers..."

# Use restart command which is more efficient than stop/start
docker compose -f docker-compose.yml restart

# Wait for services to be ready
echo "Waiting for services to be ready..."
sleep 15

# Verify containers are running
MAX_RETRIES=6
RETRY_COUNT=0
while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
    if docker compose -f docker-compose.yml ps --services --filter "status=running" | grep -q .; then
        echo "Poste.io service restarted successfully"
        exit 0
    fi
    
    RETRY_COUNT=$((RETRY_COUNT + 1))
    echo "Waiting for containers to restart... (attempt $RETRY_COUNT/$MAX_RETRIES)"
    sleep 10
done

echo "Error: Poste.io containers failed to restart properly after $MAX_RETRIES attempts" >&2
exit 1
